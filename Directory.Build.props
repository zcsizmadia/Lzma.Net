<Project>

  <PropertyGroup>
    <Version>5.8.4.3</Version>
  </PropertyGroup>

  <PropertyGroup>
    <DefaultTargetFrameworks>net8.0;net9.0;net10.0</DefaultTargetFrameworks>
    <DefaultTargetFramework>net10.0</DefaultTargetFramework>

    <!-- Portable targets for consumers that are not on .NET 8+. They have no
         hardware intrinsics, so they are always built locally too: a break
         there would otherwise only surface in CI. -->
    <PortableTargetFrameworks>netstandard2.0;netstandard2.1</PortableTargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true'">
    <ClassLibTargetFrameworks>$(DefaultTargetFrameworks);$(PortableTargetFrameworks)</ClassLibTargetFrameworks>
    <TestTargetFrameworks>$(DefaultTargetFrameworks)</TestTargetFrameworks>
    <BenchmarkTargetFramework>$(DefaultTargetFramework)</BenchmarkTargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' != 'true'">
    <ClassLibTargetFrameworks>$(DefaultTargetFramework);$(PortableTargetFrameworks)</ClassLibTargetFrameworks>
    <TestTargetFrameworks>$(DefaultTargetFramework)</TestTargetFrameworks>
    <BenchmarkTargetFramework>$(DefaultTargetFramework)</BenchmarkTargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Strong naming, so strong-named assemblies (and .NET Framework applications) can reference LzmaNet. The key
       pair is committed on purpose, as is common for open-source libraries: it gives the assembly a stable
       identity, not security. Every project is signed, because the library grants the tests and the benchmark
       access to its internals, which requires their public key. -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)LzmaNet.snk</AssemblyOriginatorKeyFile>
    <!-- The public key of LzmaNet.snk (token d7402a10f552e93b), for InternalsVisibleTo. -->
    <LzmaNetPublicKey></LzmaNetPublicKey>
  </PropertyGroup>

</Project>
