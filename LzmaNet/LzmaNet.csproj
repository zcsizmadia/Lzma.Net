<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(ClassLibTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package metadata -->
    <PackageId>Lzma.Net</PackageId>
    <Authors>Zoltan Csizmadia</Authors>
    <Copyright>Copyright (c) Zoltan Csizmadia. All rights reserved.</Copyright>
    <Description>Pure managed C# implementation of the XZ/LZMA2/LZMA compression format. No native binaries, no P/Invoke — just 100% managed code that runs anywhere .NET runs. Based on XZ Utils 5.8.4.</Description>
    <PackageLicenseExpression>0BSD</PackageLicenseExpression>
    <PackageTags>lzma;xz;compression;decompression;lzma2;xz-utils;managed;pure-csharp</PackageTags>
    <PackageProjectUrl>https://github.com/zcsizmadia/Lzma.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zcsizmadia/Lzma.Net.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial release. Pure C# port of XZ Utils 5.8.4 with LZMA/LZMA2/XZ compression, BCJ/Delta filters, multi-threaded compression, and streaming APIs.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="" />
    <None Include="../LICENSE" Pack="true" PackagePath="" />
    <None Include="../NOTICE" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Neither netstandard target has an in-box Unsafe; everything else they
       need is polyfilled under Compatibility/. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" />
  </ItemGroup>

  <!-- netstandard2.0 additionally predates Span, ValueTask and IAsyncDisposable. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" />
    <PackageReference Include="System.Threading.Tasks.Extensions" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LzmaNet.Tests" />
    <InternalsVisibleTo Include="LzmaNet.Tests.Portable20" />
    <InternalsVisibleTo Include="LzmaNet.Tests.Portable21" />
    <InternalsVisibleTo Include="LzmaNet.Tests.NetFx" />
    <InternalsVisibleTo Include="LzmaNet.Benchmark" />
  </ItemGroup>

</Project>
